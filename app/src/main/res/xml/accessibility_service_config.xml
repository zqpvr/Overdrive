<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately minimal. eventTypes is zeroed again at runtime in onServiceConnected; the
  declaration here only exists because the platform rejects a config with no event type at all.
  We never retrieve window content, never request interactive windows, and never touch input.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="1000000"
    android:description="@string/a11y_description" />
